# This repo is the marketing site. The authenticated product is a separate
# app (`mytheus-web`), so the site needs to know where to send people.
#
# Production: the app's own origin.
# Local: whatever port `mytheus-web` is running on (its dev server defaults to
# 3000, which this app already holds, so start it with `-p 3001`).
NEXT_PUBLIC_APP_URL=https://app.mytheus.cloud
