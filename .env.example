# mytheus-ui / .env.example - copy to .env.local and fill. Never commit the filled file.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time and are therefore
# public forever. Everything else stays server-side (RSC, route handlers, Server Actions).
# A secret in a NEXT_PUBLIC_ var is exfiltratable from the shipped JS.

# --- Clerk ---
# Publishable; safe in the bundle by design.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
CLERK_SECRET_KEY=sk_test_...

# Point Clerk's redirects at the in-app routes rather than its hosted pages, so the
# multi-step flows stay on our domain.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Backend ---
# The api-gateway origin, and the ONLY REST origin this app holds. Never a service URL:
# going straight to core-api or bff would bypass the edge that derives org_id from the token.
#
# Server-side (unprefixed) is preferred: every read in this app happens in a Server Component,
# so the browser never needs the origin at all. The NEXT_PUBLIC_ variant below is the fallback
# for a future client-side read and can be dropped if none appears.
API_GATEWAY_URL=http://localhost:8080
# NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080

# --- Later bands ---
# Realtime lands with Plan 3-4; LiveKit with the media thread. Listed so the shape of a full
# environment is visible; unused today.
# NEXT_PUBLIC_REALTIME_WS_URL=
# NEXT_PUBLIC_LIVEKIT_URL=
# NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
